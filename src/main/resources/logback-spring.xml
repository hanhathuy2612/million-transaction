<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Import Spring Boot default configuration -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <!-- Console Appender with enhanced colors -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%clr(%d{HH:mm:ss.SSS}){faint} %clr(%-5level) %clr([%15.15t]){yellow}
                %clr(%-40.40logger{39}){cyan} %clr(:){faint} %clr(%m){white}%n%wEx</pattern>
        </encoder>
        <withJansi>true</withJansi>
    </appender>

    <!-- Simple logger configuration -->
    <logger name="com.hnh.example.transaction_example" level="DEBUG" />

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>