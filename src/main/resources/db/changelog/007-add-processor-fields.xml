<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="007-add-processor-fields" author="system">
        <comment>Add processor transaction ID and processor name fields to payments table</comment>
        
        <addColumn tableName="payments">
            <column name="processor_transaction_id" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <addColumn tableName="payments">
            <column name="processor_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <createIndex tableName="payments" indexName="idx_payments_processor_transaction_id">
            <column name="processor_transaction_id"/>
        </createIndex>
        
    </changeSet>

</databaseChangeLog>

